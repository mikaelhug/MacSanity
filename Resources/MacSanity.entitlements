<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  MacSanity is intentionally NON-sandboxed: a session-level active CGEventTap
	  and the IOHID SPIs are incompatible with the App Sandbox. The
	  `com.apple.security.app-sandbox` key is deliberately absent. Access to scroll
	  events is gated by user-granted TCC permissions (Accessibility + Input
	  Monitoring), not by entitlements. DDC/CI brightness talks to the display
	  coprocessor through IOAVService, which likewise needs no sandbox or TCC grant.
	  The cleaner reads the whole disk (better with Full Disk Access, granted by
	  the user in System Settings) and moves items to the Trash; system-wide items
	  go through one standard admin password prompt, with no privileged helper.
	-->
</dict>
</plist>
